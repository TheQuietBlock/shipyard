# Shipyard flight-tracking configuration TEMPLATE.
#
# On the Pi:   cp temp.env .env   and fill in the blanks.
# .env is git-ignored; this template is not. Never put real keys in here.

# --------------------------------------------------
# Station location and identity
# --------------------------------------------------
FEEDER_TZ=Europe/Amsterdam
FEEDER_LAT=
FEEDER_LONG=
FEEDER_ALT_M=
FEEDER_NAME="Shipyard ADS-B"

# --------------------------------------------------
# SDR
# --------------------------------------------------
# Dongle serial. Find it with: docker exec ultrafeeder rtl_test -t
# Leave blank if you only ever run one dongle.
ADSB_SDR_SERIAL=

# --------------------------------------------------
# Feeder identity
# --------------------------------------------------
# Shared UUID for the aggregators fed natively by ultrafeeder.
# Generate once on the Pi with:  cat /proc/sys/kernel/random/uuid
MULTIFEEDER_UUID=

# ADSB Exchange wants its own UUID. Generate the same way.
ADSBX_UUID=

# --------------------------------------------------
# Aggregators needing their own container + key
# --------------------------------------------------
# https://www.flightradar24.com/share-your-data
FR24_SHARING_KEY=

# https://flightaware.com/adsb/piaware/
FLIGHTAWARE_FEEDER_ID=

# AirNav Radar. On first run the container generates a key and prints it to
# its log:  docker compose logs airnavradar | grep -i key
# Start with this blank, grab the key, then paste it back in here.
AIRNAV_SHARING_KEY=

# https://planefinder.net/sharing/create-sharecode
PLANEFINDER_SHARECODE=

# --------------------------------------------------
# Optional
# --------------------------------------------------
# HeyWhatsThat range rings - https://www.heywhatsthat.com/
FEEDER_HEYWHATSTHAT_ID=
FEEDER_HEYWHATSTHAT_ALTS=12192,24384,36576

# Portainer Business Edition license key
PORTAINER_LICENSE_KEY=
